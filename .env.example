# Подключение к PostgreSQL (локально — контейнер из docker-compose на порту 5433)
DATABASE_URL=postgresql://sofario:sofario@127.0.0.1:5433/sofario
POSTGRES_PASSWORD=sofario

# Случайная строка: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Публичный адрес сайта (в продакшене — https://ваш-домен.ru)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Уведомления о заявках в Telegram (необязательно): токен от @BotFather и id чата
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
